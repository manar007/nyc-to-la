<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>NYC → LA Road Trip (Nov 2–12, 2026)</name>
    <description>Post-marathon 10-day southern crossing. Nine overnights, one finish line at the Pacific.</description>
