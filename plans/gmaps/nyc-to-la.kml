    <Placemark>
      <name>Route</name>
      <Style><LineStyle><color>ffe094fb</color><width>3</width></LineStyle></Style>
      <LineString><tessellate>1</tessellate><coordinates>
        -74.006,40.7128,0 -74.9083,40.6367,0 -78.1975,38.9155,0 -78.4358,38.5218,0 -78.7328,38.2338,0 -78.8697,38.434,0 -78.8583,38.0338,0 -79.6058,37.4463,0 -82.5515,35.5951,0 -83.4247,35.6111,0 -83.4952,35.5568,0 -86.7816,36.1627,0 -90.0578,35.1341,0 -101.8313,35.2219,0 -101.6579,34.9349,0 -103.725,35.1717,0 -106.6504,35.0844,0 -109.781,35.0654,0 -111.0224,35.0272,0 -112.1394,36.0553,0 -111.3743,36.8619,0 -111.5104,36.8791,0 -112.9868,37.2,0 -114.5225,36.4293,0 -118.4973,34.0089,0 -118.805,34.0,0 -118.8737,34.0357,0 -118.4085,33.9416,0
      </coordinates></LineString>
    </Placemark>
    <Folder>
      <name>Day 1 — The tunnel, the ridge, the flush (Mon Nov 2, 2026)</name>
      <Placemark>
        <name>Clinton (NJ)</name>
        <description><![CDATA[<b>Clinton Station Diner, 2 Bank St, Clinton, NJ 08809</b><br/><b>Note:</b> First flush stop. Walk the lot for five minutes before you sit down.<br/><b>Eat:</b> Clinton Station Diner — real Jersey diner, sit at the counter.<br/><b>See:</b> Nothing scenic yet — this stop is for the legs.<br/><b>Highway:</b> I-78 W · Exit 15]]></description>
        <styleUrl>#meal-pin</styleUrl>
        <Point><coordinates>-74.9083,40.6367,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Front Royal (VA)</name>
        <description><![CDATA[<b>Spelunker's, 116 South St, Front Royal, VA 22630</b><br/><b>Note:</b> Fill the tank here. No fuel available inside Shenandoah NP in November.<br/><b>Eat:</b> Spelunker's — cavern-themed burger + frozen custard.<br/><b>See:</b> Shenandoah River from the bridge on your way in.<br/><b>Highway:</b> I-81 S · US-340]]></description>
        <styleUrl>#meal-pin</styleUrl>
        <Point><coordinates>-78.1975,38.9155,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Big Meadows (VA)</name>
        <description><![CDATA[<b>Big Meadows Wayside, Skyline Drive mp 51, Shenandoah NP</b><br/><b>Note:</b> Pit stop and horizon check. Ten minutes, then back on Skyline south.<br/><b>Eat:</b> Thermos coffee refill only.<br/><b>See:</b> Open sky over the meadow. Deer at any hour.<br/><b>Highway:</b> Skyline Drive · mp 51]]></description>
        <styleUrl>#scenic-pin</styleUrl>
        <Point><coordinates>-78.4358,38.5218,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Blackrock Summit (VA)</name>
        <description><![CDATA[<b>Blackrock Summit Trailhead, Skyline Drive mp 84.8</b><br/><b>Note:</b> 1.0 mi loop, 175 ft gain, ~45 min. Non-optional recovery flush.<br/><b>Eat:</b> Snack in the day pack. Water — 1L minimum.<br/><b>See:</b> 360° stone-field summit. Four ridges deep.<br/><b>Highway:</b> Skyline Drive · mp 84.8]]></description>
        <styleUrl>#activity-pin</styleUrl>
        <Point><coordinates>-78.7328,38.2338,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Harrisonburg (VA)</name>
        <description><![CDATA[<b>Hotel Madison, 710 S Main St, Harrisonburg, VA 22801</b><br/><b>Note:</b> Hotel Madison is the pick. Alt: Blackburn Inn in Staunton (25 mi south).<br/><b>Eat:</b> Jack Brown's Beer &amp; Burger or Pale Fire Brewing.<br/><b>See:</b> Downtown Harrisonburg. Walkable.<br/><b>Highway:</b> US-33 W · via Swift Run Gap]]></description>
        <styleUrl>#hotel-pin</styleUrl>
        <Point><coordinates>-78.8697,38.434,0</coordinates></Point>
      </Placemark>
    </Folder>
    <Folder>
      <name>Day 2 — Blue Ridge Parkway south (Tue Nov 3, 2026)</name>
      <Placemark>
        <name>Rockfish Gap (VA)</name>
        <description><![CDATA[<b>Blue Ridge Parkway mp 0, Waynesboro, VA</b><br/><b>Note:</b> Fuel and provisions before entering. No gas on the BRP itself.<br/><b>Eat:</b> Coffee thermos filled at Shen Valley in Harrisonburg.<br/><b>See:</b> Blue Ridge Parkway mp 0 sign.<br/><b>Highway:</b> I-64 E · BRP entry]]></description>
        <styleUrl>#scenic-pin</styleUrl>
        <Point><coordinates>-78.8583,38.0338,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Peaks of Otter (VA)</name>
        <description><![CDATA[<b>Peaks of Otter, BRP mp 86, Bedford, VA</b><br/><b>Note:</b> BRP highlight. 30 min minimum, 1 hr if the light is good.<br/><b>Eat:</b> Sharp Top Trail overlook lunch. Sandwich from the wayside store.<br/><b>See:</b> Abbott Lake reflection of Sharp Top.<br/><b>Highway:</b> Blue Ridge Parkway · mp 86]]></description>
        <styleUrl>#scenic-pin</styleUrl>
        <Point><coordinates>-79.6058,37.4463,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Asheville (NC)</name>
        <description><![CDATA[<b>Downtown Asheville, NC</b><br/><b>Note:</b> Cut Mabry Mill for time. Drop off BRP near Buchanan, take I-81/I-40.<br/><b>Eat:</b> Wicked Weed / Burial Beer / Cúrate / 12 Bones BBQ.<br/><b>See:</b> River Arts District (RAD) if you have daylight.<br/><b>Highway:</b> US-11 · I-81 S · I-40 W]]></description>
        <styleUrl>#hotel-pin</styleUrl>
        <Point><coordinates>-82.5515,35.5951,0</coordinates></Point>
      </Placemark>
    </Folder>
    <Folder>
      <name>Day 3 — Smokies at dawn, hot chicken at dusk (Wed Nov 4, 2026)</name>
      <Placemark>
        <name>Newfound Gap (TN/NC)</name>
        <description><![CDATA[<b>Newfound Gap Overlook, Great Smoky Mountains NP</b><br/><b>Note:</b> Pivot moment: leaving the East. ~20 min stop.<br/><b>Eat:</b> Nothing — no food service in the park corridor.<br/><b>See:</b> State line marker. Appalachian Trail crosses here.<br/><b>Highway:</b> US-441 · Newfound Gap Rd]]></description>
        <styleUrl>#scenic-pin</styleUrl>
        <Point><coordinates>-83.4247,35.6111,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Clingmans Dome (TN)</name>
        <description><![CDATA[<b>Clingmans Dome Observation Tower, Great Smoky Mountains NP</b><br/><b>Note:</b> Paved 0.5-mi climb. ~30 min round trip.<br/><b>Eat:</b> Water only.<br/><b>See:</b> Highest point in the Smokies (6,643 ft). 360° tower view.<br/><b>Highway:</b> Clingmans Dome Rd]]></description>
        <styleUrl>#activity-pin</styleUrl>
        <Point><coordinates>-83.4952,35.5568,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Nashville (TN)</name>
        <description><![CDATA[<b>East Nashville or Germantown, Nashville, TN</b><br/><b>Note:</b> Target East Nashville or Germantown. Book ahead — Wed nights are surprisingly busy.<br/><b>Eat:</b> Prince's Hot Chicken (Nashville original) or Hattie B's.<br/><b>See:</b> East Nashville or Germantown. Skip lower Broadway.<br/><b>Highway:</b> I-40 W · US-129]]></description>
        <styleUrl>#hotel-pin</styleUrl>
        <Point><coordinates>-86.7816,36.1627,0</coordinates></Point>
      </Placemark>
    </Folder>
    <Folder>
      <name>Day 4 — Nashville → Memphis → the plains (Thu Nov 5, 2026)</name>
      <Placemark>
        <name>Memphis (TN)</name>
        <description><![CDATA[<b>National Civil Rights Museum, 450 Mulberry St, Memphis, TN 38103</b><br/><b>Note:</b> 2.5 hr stop total: 90 min museum + 45 min lunch + walk.<br/><b>Eat:</b> Central BBQ, 147 E Butler Ave — pulled pork plate.<br/><b>See:</b> National Civil Rights Museum at the Lorraine Motel. 90 min minimum.<br/><b>Highway:</b> I-40 W]]></description>
        <styleUrl>#meal-pin</styleUrl>
        <Point><coordinates>-90.0578,35.1341,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Amarillo (TX)</name>
        <description><![CDATA[<b>I-40 corridor, Amarillo, TX</b><br/><b>Note:</b> THE transit day. Over 11 hrs door to door. Arrive ~10 PM. Sleep hard.<br/><b>Eat:</b> Late arrival — hotel bar or 24-hr taqueria off I-40.<br/><b>See:</b> The horizon flattening for hours. Sunset in Oklahoma.<br/><b>Highway:</b> I-40 W · through Little Rock, OKC]]></description>
        <styleUrl>#hotel-pin</styleUrl>
        <Point><coordinates>-101.8313,35.2219,0</coordinates></Point>
      </Placemark>
    </Folder>
    <Folder>
      <name>Day 5 — Palo Duro and the high desert (Fri Nov 6, 2026)</name>
      <Placemark>
        <name>Palo Duro Canyon (TX)</name>
        <description><![CDATA[<b>Palo Duro Canyon State Park, 11450 State Hwy Park Rd 5, Canyon, TX 79015</b><br/><b>Note:</b> Real 2-hour stop, not a drive-by. Cadillac Ranch cut.<br/><b>Eat:</b> Nothing — provisions from Amarillo.<br/><b>See:</b> 'Grand Canyon of Texas.' Red rock, 800 ft deep.<br/><b>Highway:</b> TX-217 · Park Rd 5]]></description>
        <styleUrl>#scenic-pin</styleUrl>
        <Point><coordinates>-101.6579,34.9349,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Tucumcari (NM)</name>
        <description><![CDATA[<b>Route 66, Tucumcari, NM 88401</b><br/><b>Note:</b> Get off I-40, drive Tucumcari Blvd end to end, then back on the highway.<br/><b>Eat:</b> Del's Restaurant — neon cow sign, real green chile.<br/><b>See:</b> Blue Swallow Motel neon at dusk.<br/><b>Highway:</b> I-40 W · Route 66 downtown loop]]></description>
        <styleUrl>#meal-pin</styleUrl>
        <Point><coordinates>-103.725,35.1717,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Albuquerque (NM)</name>
        <description><![CDATA[<b>BLM dispersed camping, west of Albuquerque, NM</b><br/><b>Note:</b> First car-camping night. Elevation ~5,300 ft, near-freezing overnight.<br/><b>Eat:</b> Green chile cheeseburger at Sadie's, 5400 Cutler Ave.<br/><b>See:</b> Sandia Peak turning pink at sunset.<br/><b>Highway:</b> I-40 W]]></description>
        <styleUrl>#camp-pin</styleUrl>
        <Point><coordinates>-106.6504,35.0844,0</coordinates></Point>
      </Placemark>
    </Folder>
    <Folder>
      <name>Day 6 — Painted rock to the great crack (Sat Nov 7, 2026)</name>
      <Placemark>
        <name>Painted Desert (AZ)</name>
        <description><![CDATA[<b>Painted Desert Visitor Center, Petrified Forest NP, AZ</b><br/><b>Note:</b> Enter north, exit south. 2 hours minimum inside the park.<br/><b>Eat:</b> Cold breakfast from the cooler on the rim.<br/><b>See:</b> Painted Desert rim + Petrified Forest 28-mi scenic road.<br/><b>Highway:</b> I-40 W · PEFO N entrance]]></description>
        <styleUrl>#scenic-pin</styleUrl>
        <Point><coordinates>-109.781,35.0654,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Meteor Crater (AZ)</name>
        <description><![CDATA[<b>Meteor Crater Natural Landmark, Winslow, AZ 86047</b><br/><b>Note:</b> 20 min off I-40, ~45 min at the rim.<br/><b>Eat:</b> Small deli inside the visitor center.<br/><b>See:</b> 0.7-mi-wide asteroid impact crater. 50,000 years old.<br/><b>Highway:</b> I-40 W · exit 233]]></description>
        <styleUrl>#scenic-pin</styleUrl>
        <Point><coordinates>-111.0224,35.0272,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Grand Canyon (AZ)</name>
        <description><![CDATA[<b>Mather Campground, Grand Canyon South Rim, AZ</b><br/><b>Note:</b> Mather Campground — Sat Nov 7 = weekend, book EARLY.<br/><b>Eat:</b> Camp stove: pasta + a can of chile. Or Bright Angel restaurant.<br/><b>See:</b> South Rim at sunset. Hopi Point or Yavapai Point.<br/><b>Highway:</b> US-180 N · AZ-64 N]]></description>
        <styleUrl>#camp-pin</styleUrl>
        <Point><coordinates>-112.1394,36.0553,0</coordinates></Point>
      </Placemark>
    </Folder>
    <Folder>
      <name>Day 7 — Slot canyon light, red rock camp (Sun Nov 8, 2026)</name>
      <Placemark>
        <name>Antelope Canyon (AZ)</name>
        <description><![CDATA[<b>Upper Antelope Canyon, Page, AZ 86040</b><br/><b>Note:</b> The one time-locked booking of the trip. 8-10 AM slot for the beams.<br/><b>Eat:</b> Coffee in Page — Big John's or Ravens Cafe.<br/><b>See:</b> Sandstone light beams. Navajo-guided only.<br/><b>Highway:</b> US-89 N]]></description>
        <styleUrl>#activity-pin</styleUrl>
        <Point><coordinates>-111.3743,36.8619,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Horseshoe Bend (AZ)</name>
        <description><![CDATA[<b>Horseshoe Bend Overlook, Page, AZ</b><br/><b>Note:</b> 45 min stop. Then push west through Kanab to Zion.<br/><b>Eat:</b> Post-tour lunch: State 48 Tavern or Bonkers in Page.<br/><b>See:</b> Colorado River in a perfect horseshoe, 1,000 ft below.<br/><b>Highway:</b> US-89 · 5 min south of Page]]></description>
        <styleUrl>#scenic-pin</styleUrl>
        <Point><coordinates>-111.5104,36.8791,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Zion National Park (UT)</name>
        <description><![CDATA[<b>Watchman Campground, Zion NP, Springdale, UT</b><br/><b>Note:</b> Two nights here (Sun + Mon). Watchman = walk-in campground with hot showers.<br/><b>Eat:</b> Springdale: Oscar's Cafe (fish tacos) or MeMe's Cafe (crepes).<br/><b>See:</b> Watchman peak turning red at sunset from camp.<br/><b>Highway:</b> US-89A · UT-9]]></description>
        <styleUrl>#camp-pin</styleUrl>
        <Point><coordinates>-112.9868,37.2,0</coordinates></Point>
      </Placemark>
    </Folder>
    <Folder>
      <name>Day 9 — Mojave to the Pacific (Tue Nov 10, 2026)</name>
      <Placemark>
        <name>Valley of Fire (NV)</name>
        <description><![CDATA[<b>Valley of Fire State Park Visitor Center, Overton, NV</b><br/><b>Note:</b> 1.5 hr stop before the LA push. Last true desert of the trip.<br/><b>Eat:</b> Provisions from Springdale gas station or St. George.<br/><b>See:</b> Red sandstone spires. Fire Wave loop is 1.5 mi.<br/><b>Highway:</b> I-15 S · NV-169]]></description>
        <styleUrl>#scenic-pin</styleUrl>
        <Point><coordinates>-114.5225,36.4293,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Los Angeles (CA)</name>
        <description><![CDATA[<b>Santa Monica / Venice / Malibu, Los Angeles, CA</b><br/><b>Note:</b> Book Santa Monica specifically — Wed morning is PCH north to Point Dume + El Matador.<br/><b>Eat:</b> Gjelina in Venice or Bay Cities Deli in Santa Monica.<br/><b>See:</b> The Pacific. Stand there until the engine ticks cool.<br/><b>Highway:</b> I-15 S · I-10 W]]></description>
        <styleUrl>#hotel-pin</styleUrl>
        <Point><coordinates>-118.4973,34.0089,0</coordinates></Point>
      </Placemark>
    </Folder>
    <Folder>
      <name>Day 10 — PCH morning + wheels up (Wed Nov 11 – Thu Nov 12, 2026)</name>
      <Placemark>
        <name>Point Dume (CA)</name>
        <description><![CDATA[<b>Point Dume State Beach &amp; Nature Preserve, 6800 Westward Beach Rd, Malibu, CA 90265</b><br/><b>Note:</b> First real PCH stop, Wed ~9 AM. 45 min: cliff loop trail + optional 15 min down the stairs to sea level.<br/><b>Eat:</b> Coffee at Malibu Farm Pier Cafe on the way out. Nothing at the point itself — bring water.<br/><b>See:</b> Cliffside overlook of the whale-migration channel. Gray whales southbound in November. Stairs down to the tide pools.<br/><b>Highway:</b> PCH (CA-1) · north from Santa Monica]]></description>
        <styleUrl>#scenic-pin</styleUrl>
        <Point><coordinates>-118.805,34.0,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>El Matador (CA)</name>
        <description><![CDATA[<b>El Matador State Beach, 32350 Pacific Coast Hwy, Malibu, CA 90265</b><br/><b>Note:</b> The Pacific recovery plunge, if the surf is calm: 3 min cold, 10 min in the sun, repeat twice. Cold water on marathon-tired quads.<br/><b>Eat:</b> Neptune's Net (42505 PCH, 5 mi further north) — burger + fried shrimp if the mood strikes. Otherwise cooler snacks.<br/><b>See:</b> Sea stacks, sandstone arches, tide pools. The postcard-Malibu photograph.<br/><b>Highway:</b> PCH (CA-1) · 4 mi north of Point Dume]]></description>
        <styleUrl>#activity-pin</styleUrl>
        <Point><coordinates>-118.8737,34.0357,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>LAX — Wheels Up (CA)</name>
        <description><![CDATA[<b>Los Angeles International Airport (LAX)</b><br/><b>Note:</b> Wed ~2 PM back at Santa Monica (wash car, gas, repack). Sleep SM. Thu Nov 12: leave hotel 10:30, rental drop 11:30, LAX 12:00, wheels up 15:00.<br/><b>Eat:</b> Coffee at the gate. You made it.<br/><b>See:</b> The Pacific one more time out the window on takeoff.<br/><b>Highway:</b> PCH S → I-10 E → I-405 S]]></description>
        <styleUrl>#finish-pin</styleUrl>
        <Point><coordinates>-118.4085,33.9416,0</coordinates></Point>
      </Placemark>
    </Folder>
    <Folder>
      <name>Day 0 — Start (NYC)</name>
      <Placemark>
        <name>New York City</name>
        <description><![CDATA[Leave the LIC / UWS hotel by 7 AM. Uber to EWR to pick up the SUV. Wheels rolling on I-78 W by 8:15.]]></description>
        <styleUrl>#start-pin</styleUrl>
        <Point><coordinates>-74.006,40.7128,0</coordinates></Point>
      </Placemark>
    </Folder>
  </Document>
</kml>
